    "/videos/{slug}/stream": {
      "get": {
        "description": "Proxies the original through the API. A Range header returns 206 with Content-Range.",
        "operationId": "VideosController_stream",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "description": "Public 11-character video identifier",
            "schema": {
              "example": "Ab3dE5fG7hI",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full video body"
          },
          "206": {
            "description": "Requested byte range"
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found or owned by another channel",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is not ready",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "416": {
            "description": "Range is malformed, multiple, or starts past the end",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Stream the original video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{slug}/download": {
      "get": {
        "description": "Same as stream, sent as an attachment named after the original file. Accepts Range to resume.",
        "operationId": "VideosController_download",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "description": "Public 11-character video identifier",
            "schema": {
              "example": "Ab3dE5fG7hI",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full video as an attachment"
          },
          "206": {
            "description": "Requested byte range as an attachment"
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found or owned by another channel",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is not ready",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "416": {
            "description": "Range is malformed, multiple, or starts past the end",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Download the original video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{slug}/thumbnail": {
      "get": {
        "description": "Returns the JPEG thumbnail generated by the worker.",
        "operationId": "VideosController_thumbnail",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "description": "Public 11-character video identifier",
            "schema": {
              "example": "Ab3dE5fG7hI",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JPEG thumbnail"
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "image/jpeg": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found or owned by another channel",
            "content": {
              "image/jpeg": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is not ready",
            "content": {
              "image/jpeg": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get the video thumbnail",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "InitiateUploadDto": {
        "type": "object",
        "properties": {
          "contentType": {
            "type": "string",
            "enum": [
              "video/mp4",
              "video/webm",
              "video/quicktime",
              "video/x-matroska"
            ],
            "example": "video/mp4"
          }
        },
        "required": [
          "contentType"
        ]
      },
      "InitiateUploadResponseDto": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "Ab3dE5fG7hI",
            "minLength": 11,
            "maxLength": 11
          },
          "processingStatus": {
            "type": "string",
            "enum": [
              "uploading",
              "processing",
              "ready",
              "failed"
            ],
            "example": "uploading"
          },
          "publicationStatus": {
            "type": "string",
            "enum": [
              "draft"
            ],
            "example": "draft"
          },
          "partSizeBytes": {
            "type": "number",
            "example": 67108864,
            "description": "Part size in bytes"
          },
          "partCount": {
            "type": "number",
            "example": 1,
            "description": "ceil(sizeBytes / partSizeBytes)"
          },
          "maxBytes": {
            "type": "number",
            "example": 10737418240,
            "description": "Maximum upload size"
          },
          "urlTtlSeconds": {
            "type": "number",
            "example": 3600,
            "description": "Lifetime of presigned URLs"
          }
        },
        "required": [
          "slug",
          "processingStatus",
          "publicationStatus",
          "partSizeBytes",
          "partCount",
          "maxBytes",
          "urlTtlSeconds"
        ]
      },
      "SignUploadPartsDto": {
        "type": "object",
        "properties": {}
      },
      "UploadPartUrlDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "example": "http://localhost:9000/streamtube/videos/.../original?X-Amz-Signature=...",
            "description": "Presigned URL; PUT the part bytes directly to it"
          }
        },
        "required": [
          "partNumber",
          "url"
        ]
      },
      "SignUploadPartsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadPartUrlDto"
            }
          },
          "expiresAt": {
            "type": "string",
            "example": "2026-11-03T13:00:00.000Z",
            "description": "Instant after which the presigned URLs stop working"
          }
        },
        "required": [
          "parts",
          "expiresAt"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1
          },
          "etag": {
            "type": "string",
            "example": "\"9bb58f26192e4ba00f01e2e7b136dbd4\""
          },
          "sizeBytes": {
            "type": "number",
            "example": 67108864
          }
        },
        "required": [
          "partNumber",
          "etag",
          "sizeBytes"
        ]
      },
      "ListUploadedPartsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {}
      },
      "CompleteUploadResponseDto": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "Ab3dE5fG7hI"
          },
          "processingStatus": {
            "type": "string",
            "enum": [
              "uploading",
              "processing",
              "ready",
              "failed"
            ],
            "example": "processing"
          }
        },
        "required": [
          "slug",
          "processingStatus"
        ]
      },
      "VideoDetailsResponseDto": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "Ab3dE5fG7hI"
          },
          "title": {
            "type": "string",
            "example": "clip.mp4"
          },
          "originalFileName": {
            "type": "string",
            "example": "clip.mp4"
          },
          "contentType": {
            "type": "string",
            "example": "video/mp4"
          },
          "sizeBytes": {
            "type": "number",
            "example": 1048576
          },
          "processingStatus": {
            "type": "string",
            "enum": [
              "uploading",
              "processing",
              "ready",
              "failed"
            ],
            "example": "ready"
          },
          "publicationStatus": {
            "type": "string",
            "enum": [
              "draft"
            ],
            "example": "draft"
          },
          "durationSeconds": {
            "type": "number",
            "example": 2,
            "nullable": true
          },
          "metadata": {
            "type": "object",
            "nullable": true,
            "example": {
              "formatName": "mov,mp4",
              "bitRate": 100000,
              "width": 320,
              "height": 240,
              "videoCodec": "h264",
              "audioCodec": null,
              "frameRate": 25
            }
          },
          "hasThumbnail": {
            "type": "boolean",
            "example": true
          },
          "processingError": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "createdAt": {
            "type": "string",
            "example": "2026-11-03T13:00:00.000Z"
          },
          "processedAt": {
            "type": "string",
            "nullable": true,
            "example": "2026-11-03T13:01:00.000Z"
          }
        },
        "required": [
          "slug",
          "title",
          "originalFileName",
          "contentType",
          "sizeBytes",
          "processingStatus",
          "publicationStatus",
          "durationSeconds",
          "metadata",
          "hasThumbnail",
          "processingError",
          "createdAt",
          "processedAt"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}